PORT=3000

# Provider calls stay disabled until you explicitly review their cost and quota.
GEMINI_API_KEY=
ENABLE_GEMINI_API=false
ENABLE_PAID_VIDEO_API=false

# Firebase Admin: use one secure server-side method.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS to a local, gitignored JSON key path.
# On supported Google Cloud runtimes, Application Default Credentials can be used.

# These are optional IP-based limits for text/image demo endpoints only.
DAILY_TEXT_LIMIT=20
DAILY_IMAGE_LIMIT=3

# Firebase Web app config (public project metadata; safe to expose to browsers).
# Copy these values from Firebase Console > Project settings > Your apps.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
