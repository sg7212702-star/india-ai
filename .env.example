PORT=3000

# Optional Gemini text/image calls stay disabled until costs and quotas are reviewed.
GEMINI_API_KEY=
ENABLE_GEMINI_API=false
GENERATION_QUEUE_ENABLED=false # Keep false until a durable worker is deployed and tested.
REFERENCE_IMAGE_UPLOAD_ENABLED=false # Storage upload is opt-in; review billing first.

# Firebase Admin: use one secure server-side method.
FIREBASE_PROJECT_ID=
# Private Firebase Storage bucket for MP4 outputs. Do not enable public access.
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS to a local, gitignored JSON key path.
# On supported Google Cloud runtimes, Application Default Credentials can be used.

# These are optional IP-based limits for text/image demo endpoints only.
DAILY_TEXT_LIMIT=20
DAILY_IMAGE_LIMIT=3

# Firebase Web app config (public project metadata; safe to expose to browsers).
# Copy these values from Firebase Console > Project settings > Your apps.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=


# Separate worker process. No adapter is included yet, so leave unset.
# VIDEO_ADAPTER_MODULE=./private/video-adapter.js
# WORKER_ID=
# WORKER_LEASE_MS=120000
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_MAX_ATTEMPTS=3
# WORKER_BATCH_SIZE=10
